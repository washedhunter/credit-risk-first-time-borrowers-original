# Copy to .env (never commit .env). Only needed for a full retrain; the demo needs no keys.

# Kaggle: kaggle.com -> Settings -> API -> Generate New Token. Accept the competition rules first:
# https://www.kaggle.com/competitions/home-credit-default-risk/rules
KAGGLE_API_TOKEN=

# Optional overrides (defaults shown)
# SEED=42
# HOLDOUT_FRACTION=0.2
# N_FOLDS=5
# Expected-cost assumptions, as a fraction of the loan amount (illustrative):
# LOSS_GIVEN_DEFAULT=0.45
# MARGIN_GOOD_LOAN=0.10
# DATA_DIR=data
# MODELS_DIR=models
# REPORTS_DIR=reports
# IMG_DIR=docs/img
